{
  "name": "codex-session-tracker",
  "displayName": "Codex Session Tracker",
  "description": "Codex activity tracker with a Windows VS Code gateway, managed reversible routing, full request/response capture, and lifecycle-accurate steer diagnostics.",
  "version": "0.13.4",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "openai",
    "status",
    "session",
    "tracker"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexSessionTracker.configureErrorSound",
        "title": "Codex Tracker: Chọn âm thanh lỗi 429 (MP3)"
      },
      {
        "command": "codexSessionTracker.previewErrorSound",
        "title": "Codex Tracker: Nghe thử âm thanh lỗi 429"
      },
      {
        "command": "codexSessionTracker.configureModelCapacitySound",
        "title": "Codex Tracker: Chọn âm thanh cứu hoả cho model quá tải"
      },
      {
        "command": "codexSessionTracker.previewModelCapacitySound",
        "title": "Codex Tracker: Nghe thử âm thanh cứu hoả"
      },
      {
        "command": "codexSessionTracker.configureUserInputSound",
        "title": "Codex Tracker: Chọn âm báo khi Codex chờ trả lời"
      },
      {
        "command": "codexSessionTracker.previewUserInputSound",
        "title": "Codex Tracker: Nghe thử âm báo chờ trả lời"
      },
      {
        "command": "codexSessionTracker.openErrorHistory",
        "title": "Codex Tracker: Xem lịch sử lỗi 429"
      },
      {
        "command": "codexSessionTracker.configureProxyWatchdog",
        "title": "Codex Tracker: Configure Proxy Auto Restart"
      },
      {
        "command": "codexSessionTracker.restartLocalProxy",
        "title": "Codex Tracker: Restart Local Proxy"
      },
      {
        "command": "codexSessionTracker.configureLocalProxy",
        "title": "Codex Tracker: Choose Local Proxy EXE"
      },
      {
        "command": "codexSessionTracker.checkUsage",
        "title": "Codex Tracker: Check Usage"
      },
      {
        "command": "codexSessionTracker.configureUsageInterval",
        "title": "Codex Tracker: Set Usage Check Interval"
      },
      {
        "command": "codexSessionTracker.configureUsageAlerts",
        "title": "Codex Tracker: Cấu hình cảnh báo quota Usage"
      },
      {
        "command": "codexSessionTracker.openTracker",
        "title": "Codex Tracker: Open Tracker"
      },
      {
        "command": "codexSessionTracker.openDashboard",
        "title": "Codex Tracker: Open Tracker"
      },
      {
        "command": "codexSessionTracker.selectChat",
        "title": "Codex Tracker: Show Running Chats"
      },
      {
        "command": "codexSessionTracker.refresh",
        "title": "Codex Tracker: Refresh"
      },
      {
        "command": "codexSessionTracker.clearSelection",
        "title": "Codex Tracker: Clear Selection"
      },
      {
        "command": "codexSessionTracker.reprobeCodexCli",
        "title": "Codex Tracker: Re-detect Codex CLI"
      },
      {
        "command": "codexSessionTracker.exportGatewayDiagnostics",
        "title": "Codex Tracker: Export Gateway Diagnostics"
      },
      {
        "command": "codexSessionTracker.openTrafficMonitor",
        "title": "Codex Tracker: Open Traffic Monitor"
      },
      {
        "command": "codexSessionTracker.deactivateSession",
        "title": "Codex Tracker: Deactivate (Xoá phiên hiện tại)"
      },
      {
        "command": "codexSessionTracker.newChat",
        "title": "Codex Tracker: Tạo chat mới với context riêng"
      },
      {
        "command": "codexSessionTracker.transferChat",
        "title": "Codex Tracker: Chuyển chat đang chọn sang chat mới"
      },
      {
        "command": "codexSessionTracker.configureNewChat",
        "title": "Codex Tracker: Cài đặt context khi tạo chat mới"
      }
    ],
    "configuration": {
      "title": "Codex Session Tracker",
      "properties": {
        "codexSessionTracker.codexHome": {
          "type": "string",
          "default": "",
          "description": "Optional Codex home directory. Empty uses CODEX_HOME or ~/.codex."
        },
        "codexSessionTracker.historyLimit": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 1000,
          "description": "Maximum number of root Codex chats shown per running or non-running view in the tracker panel."
        },
        "codexSessionTracker.includeNonVsCodeSessions": {
          "type": "boolean",
          "default": false,
          "description": "Also show Codex sessions whose source is not VS Code."
        },
        "codexSessionTracker.pollIntervalMs": {
          "type": "number",
          "default": 1500,
          "minimum": 500,
          "maximum": 10000,
          "description": "How often to refresh the pinned chat status. The tracker only reads Codex files."
        },
        "codexSessionTracker.rescanThreadEverySeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 120,
          "description": "How often to rescan Codex rollout metadata for child agents and newer physical rollouts."
        },
        "codexSessionTracker.treeScanLimit": {
          "type": "number",
          "default": 1200,
          "minimum": 50,
          "maximum": 10000,
          "description": "Maximum recent rollout files inspected when resolving the selected root thread and its child agents."
        },
        "codexSessionTracker.activityTailMb": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 32,
          "description": "Megabytes read from the tail of each root/child rollout for current activity and timeline details. Terminal task state is scanned separately across the full file."
        },
        "codexSessionTracker.timelineLimit": {
          "type": "number",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "Maximum recent activity events retained per refresh and shown in the expandable timeline."
        },
        "codexSessionTracker.activeScanEverySeconds": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 120,
          "description": "How often to rescan the running-chat list while the tracker panel is visible."
        },
        "codexSessionTracker.codexCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the Codex CLI binary used for official queue delivery. Steer uses the live Codex Extension IPC owner and does not use this path. Empty auto-detects PATH or the OpenAI Codex extension bundle."
        },
        "codexSessionTracker.gateway.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        },
        "codexSessionTracker.gateway.port": {
          "type": "number",
          "default": 8765,
          "minimum": 1,
          "maximum": 65535,
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        },
        "codexSessionTracker.gateway.modelProxyEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        },
        "codexSessionTracker.gateway.upstreamBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        },
        "codexSessionTracker.gateway.captureContent": {
          "type": "boolean",
          "default": false,
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        },
        "codexSessionTracker.gateway.traceMaxMb": {
          "type": "number",
          "default": 64,
          "minimum": 8,
          "maximum": 512,
          "description": "Compatibility setting. Gateway settings are managed from the Codex Session Tracker UI."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "codexSessionTrackerPanel",
          "title": "Codex Tracker",
          "icon": "media/tracker.svg"
        }
      ]
    },
    "views": {
      "codexSessionTrackerPanel": [
        {
          "type": "webview",
          "id": "codexSessionTracker.view",
          "name": "Codex Tracker",
          "icon": "media/tracker.svg",
          "contextualTitle": "Codex Tracker"
        }
      ]
    }
  },
  "scripts": {
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1"
  },
